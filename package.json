{
  "name": "dsh-recent-deliverables",
  "version": "1.5.0",
  "description": "A floating file panel for DeepSeek Harness with smooth batch selection, heart-bubble trash, inline renaming, a local clock, optional automatic weather, complete counts and Chinese/English.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "logic.js",
    "file-operations.js",
    "weather.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "INSTALL.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "deliverables",
    "artifacts"
  ],
  "license": "MIT",
  "author": "Jiasheng Fu",
  "homepage": "https://github.com/FelixJiashengFu/dsh-recent-deliverables#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FelixJiashengFu/dsh-recent-deliverables.git"
  },
  "bugs": {
    "url": "https://github.com/FelixJiashengFu/dsh-recent-deliverables/issues"
  },
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "trash": "^9.0.0"
  }
}
